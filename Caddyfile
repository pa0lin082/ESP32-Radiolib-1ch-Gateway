# global options
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT:80} {
	log {
		format json
	}

	# Health check endpoint (no auth required)
	respond /health 200

	# Basic Authentication
	# Usa la variabile d'ambiente BASIC_AUTH_HASH nel formato: username $2a$10$hashedpassword
	# Per generare l'hash: caddy hash-password
	# Oppure usa: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('password', 10).then(h => console.log('admin ' + h))"
	basicauth {
		{$BASIC_AUTH_HASH}
	}

	# Security headers
	header {
		# Prevent some browsers from MIME-sniffing a response away from the declared Content-Type
		X-Content-Type-Options "nosniff"
		# Remove Server header
		-Server
	}

	# serve from the 'dist' folder (Vite builds into the 'dist' folder)
	root * {{.DIST_DIR}}

	# Handle static files
	file_server {
		hide .git
		hide .env*
	}

	# Compression with more formats
	encode {
		gzip
		zstd
	}

	# Try files with HTML extension and handle SPA routing
	try_files {path} {path}.html {path}/index.html /index.html
}

